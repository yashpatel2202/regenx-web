generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id           String        @id @default(uuid())
  name         String
  industryType String
  description  String?
  address      String?
  users        User[]
  listings     Listing[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Listing {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  title          String
  description    String
  quantity       Float
  unit           String
  type           String // "WASTE" or "RAW_MATERIAL"
  pricePerUnit   Float
  status         String        @default("ACTIVE") // ACTIVE, SOLD, ARCHIVED
  specifications String? // JSON string for detailed specs
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     Company  @relation(fields: [buyerId], references: [id])
  quantity  Float
  totalCost Float
  status    String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedItem {
  id        String   @id @default(uuid())
  title     String
  content   String
  sourceUrl String?
  category  String // "NEWS", "SUCCESS_STORY", "INNOVATION"
  imageUrl  String?
  createdAt DateTime @default(now())
}
